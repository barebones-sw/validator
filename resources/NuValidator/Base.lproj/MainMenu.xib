<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24765" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24765"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="ValidatorApplicationDelegate" customModule="NuValidator" customModuleProvider="target">
            <connections>
                <outlet property="hostField" destination="host-field" id="owner-host-field"/>
                <outlet property="logTextView" destination="log-text-view" id="owner-log-text-view"/>
                <outlet property="loggingCheckbox" destination="logging-checkbox" id="owner-logging-checkbox"/>
                <outlet property="mainMenu" destination="main-menu" id="owner-main-menu"/>
                <outlet property="portField" destination="port-field" id="owner-port-field"/>
                <outlet property="statusLabel" destination="status-label" id="owner-status-label"/>
                <outlet property="urlLabel" destination="url-label" id="owner-url-label"/>
                <outlet property="window" destination="main-window" id="owner-window"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="font-manager" customClass="NSFontManager"/>
        <menu title="Main Menu" systemMenu="main" id="main-menu">
            <items>
                <menuItem title="Nu Validator" id="app-menu-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Nu Validator" systemMenu="apple" id="app-menu">
                        <items>
                            <menuItem title="About Nu Validator" id="about-menu-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="orderFrontStandardAboutPanel:" target="-1" id="about-action"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-separator-1"/>
                            <menuItem title="Show Nu Validator" keyEquivalent="0" id="show-menu-item">
                                <connections>
                                    <action selector="showWindow:" target="-2" id="show-action"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-separator-2"/>
                            <menuItem title="Hide Nu Validator" keyEquivalent="h" id="hide-menu-item">
                                <connections>
                                    <action selector="hide:" target="-1" id="hide-action"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Hide Others" keyEquivalent="h" id="hide-others-menu-item">
                                <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                                <connections>
                                    <action selector="hideOtherApplications:" target="-1" id="hide-others-action"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Show All" id="show-all-menu-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="unhideAllApplications:" target="-1" id="show-all-action"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-separator-3"/>
                            <menuItem title="Quit Nu Validator" keyEquivalent="q" id="quit-menu-item">
                                <connections>
                                    <action selector="terminate:" target="-1" id="quit-action"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="File" id="file-menu-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="File" id="file-menu">
                        <items>
                            <menuItem title="Close" keyEquivalent="w" id="close-menu-item">
                                <connections>
                                    <action selector="performClose:" target="-1" id="close-action"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Edit" id="edit-menu-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Edit" id="edit-menu">
                        <items>
                            <menuItem title="Undo" keyEquivalent="z" id="undo-menu-item">
                                <connections>
                                    <action selector="undo:" target="-1" id="undo-action"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Redo" keyEquivalent="Z" id="redo-menu-item">
                                <connections>
                                    <action selector="redo:" target="-1" id="redo-action"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="edit-separator-1"/>
                            <menuItem title="Cut" keyEquivalent="x" id="cut-menu-item">
                                <connections>
                                    <action selector="cut:" target="-1" id="cut-action"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Copy" keyEquivalent="c" id="copy-menu-item">
                                <connections>
                                    <action selector="copy:" target="-1" id="copy-action"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Paste" keyEquivalent="v" id="paste-menu-item">
                                <connections>
                                    <action selector="paste:" target="-1" id="paste-action"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Delete" id="delete-menu-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="delete:" target="-1" id="delete-action"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Select All" keyEquivalent="a" id="select-all-menu-item">
                                <connections>
                                    <action selector="selectAll:" target="-1" id="select-all-action"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Window" id="window-menu-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Window" systemMenu="window" id="window-menu">
                        <items>
                            <menuItem title="Minimize" keyEquivalent="m" id="minimize-menu-item">
                                <connections>
                                    <action selector="performMiniaturize:" target="-1" id="minimize-action"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Zoom" id="zoom-menu-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="performZoom:" target="-1" id="zoom-action"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="window-separator-1"/>
                            <menuItem title="Show Nu Validator" keyEquivalent="0" id="window-show-menu-item">
                                <connections>
                                    <action selector="showWindow:" target="-2" id="window-show-action"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Bring All to Front" id="bring-all-menu-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="arrangeInFront:" target="-1" id="bring-all-action"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
            <point key="canvasLocation" x="143" y="136"/>
        </menu>
        <window title="Nu Validator" allowsToolTipsWhenApplicationIsInactive="NO" releasedWhenClosed="NO" frameAutosaveName="NuValidatorWindow" animationBehavior="default" id="main-window">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <windowCollectionBehavior key="collectionBehavior" fullScreenNone="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" rightStrut="YES" topStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="220" y="320" width="680" height="520"/>
            <rect key="screenRect" x="0.0" y="0.0" width="2560" height="1409"/>
            <value key="minSize" type="size" width="520" height="420"/>
            <view key="contentView" id="content-view">
                <rect key="frame" x="0.0" y="0.0" width="680" height="520"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="status-label">
                        <rect key="frame" x="18" y="482" width="644" height="17"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" title="Starting checker service..." id="status-label-cell">
                            <font key="font" metaFont="systemSemibold"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="url-label">
                        <rect key="frame" x="18" y="461" width="644" height="16"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="truncatingMiddle" title="http://127.0.0.1:8888/" id="url-label-cell">
                            <font key="font" metaFont="smallSystem"/>
                            <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="host-label">
                        <rect key="frame" x="31" y="419" width="83" height="16"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Bind address" id="host-label-cell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField focusRingType="none" verticalHuggingPriority="750" id="host-field">
                        <rect key="frame" x="124" y="416" width="538" height="21"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="host-field-cell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="port-label">
                        <rect key="frame" x="18" y="388" width="96" height="16"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Port" id="port-label-cell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField focusRingType="none" verticalHuggingPriority="750" id="port-field">
                        <rect key="frame" x="124" y="385" width="538" height="21"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="port-field-cell">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <button verticalHuggingPriority="750" id="logging-checkbox">
                        <rect key="frame" x="124" y="359" width="105" height="18"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="check" title="Log requests" bezelStyle="regularSquare" imagePosition="left" inset="2" id="logging-checkbox-cell">
                            <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="loggingChanged:" target="-2" id="logging-checkbox-action"/>
                        </connections>
                    </button>
                    <button verticalHuggingPriority="750" id="save-button">
                        <rect key="frame" x="115" y="316" width="107" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Save Settings" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="save-button-cell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="saveSettings:" target="-2" id="save-action"/>
                        </connections>
                    </button>
                    <button verticalHuggingPriority="750" id="open-button">
                        <rect key="frame" x="234" y="316" width="111" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Open Checker" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="open-button-cell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="openChecker:" target="-2" id="open-action"/>
                        </connections>
                    </button>
                    <button verticalHuggingPriority="750" id="copy-button">
                        <rect key="frame" x="357" y="316" width="85" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Copy URL" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="copy-button-cell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="copyURL:" target="-2" id="copy-url-action"/>
                        </connections>
                    </button>
                    <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="log-label">
                        <rect key="frame" x="18" y="286" width="644" height="17"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" title="Request Log" id="log-label-cell">
                            <font key="font" metaFont="systemSemibold"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <scrollView autohidesScrollers="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" id="log-scroll-view">
                        <rect key="frame" x="20" y="20" width="640" height="266"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <clipView key="contentView" drawsBackground="NO" id="log-clip-view">
                            <rect key="frame" x="1" y="1" width="638" height="264"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <textView editable="NO" importsGraphics="NO" richText="NO" verticallyResizable="YES" id="log-text-view">
                                    <rect key="frame" x="0.0" y="0.0" width="638" height="264"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    <size key="minSize" width="638" height="264"/>
                                    <size key="maxSize" width="640" height="10000000"/>
                                    <color key="insertionPointColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                </textView>
                            </subviews>
                        </clipView>
                        <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" doubleValue="1" controlSize="small" horizontal="YES" id="log-horizontal-scroller">
                            <rect key="frame" x="-100" y="-100" width="87" height="18"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                        <scroller key="verticalScroller" hidden="YES" verticalHuggingPriority="750" doubleValue="1" controlSize="small" horizontal="NO" id="log-vertical-scroller">
                            <rect key="frame" x="-30" y="1" width="15" height="264"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                    </scrollView>
                    <button verticalHuggingPriority="750" id="quit-button">
                        <rect key="frame" x="454" y="316" width="50" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Quit" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="quit-button-cell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="terminate:" target="-1" id="quit-button-action"/>
                        </connections>
                    </button>
                </subviews>
            </view>
            <point key="canvasLocation" x="468" y="348"/>
        </window>
    </objects>
</document>
